[Unit]
Description=OBS Studio (PPA) on :99
Requires=oink-display.service
After=oink-display.service

[Service]
User=$OINK_USER
Environment=HOME=$OINK_HOME
Environment=DISPLAY=:99
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=RECORDING_DIR=$RECORDING_DIR
ExecStartPre=/bin/sh -c 'until DISPLAY=:99 xdpyinfo >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=/bin/sh -c '/usr/bin/pkill -x obs || true'
ExecStartPre=/bin/sh -c 'rm -f $OINK_HOME/.config/obs-studio/.sentinel/*'
# Pin RecFilePath to the monitored recordings dir in every OBS profile before
# launch (handles profile churn: new/duplicated profiles reset the path to
# ~/Videos).
ExecStartPre=/bin/sh -c '$OINK_LIBEXEC/oink-pin-recordings.sh $RECORDING_DIR'
# Golden user.ini seeds the OBS profile UI settings (geometry/docks) on FIRST
# boot only. It belongs in the active profile dir (basic/profiles/oink/user.ini),
# NOT at obs-studio/user.ini — ensure the dir exists first (may not yet on day 1).
# Once the profile exists, runtime UI state (dock layout, toggles) is left alone;
# re-imposing the golden layout every start would wipe docks like Aitum's
# Multistream / Vertical Canvas on every restart.
#
# NOTE: never pre-create obs-studio/user.ini (top-level). OBS refuses to run its
# first-run config migration — "Unable to migrate global configuration - user
# configuration file already exists" — when that file exists before OBS's first
# launch, so the auto-config wizard is suppressed via global.ini LastVersion
# (set by the `oink setup` host phase) instead.
ExecStartPre=/bin/sh -c 'install -d -m 0755 $OINK_HOME/.config/obs-studio/basic/profiles/oink && { [ -f $OINK_HOME/.config/obs-studio/basic/profiles/oink/user.ini ] || /usr/bin/install -m 0644 $OINK_HOME/user.ini.golden $OINK_HOME/.config/obs-studio/basic/profiles/oink/user.ini; }'
ExecStart=/usr/bin/obs --websocket_port=4455 --websocket_password=$PW
# Gracefully stop the OBS virtual camera before the unit tears OBS down — a live
# restart while the cam is held by a consumer (v4l2loopback) can stall the unit.
# Runs while OBS is still alive (systemd runs ExecStop before signalling the main
# process); dead/unreachable OBS is swallowed so stopping is never blocked.
ExecStop=/usr/bin/node $STACK_DIR/stop-vcam.js
ExecStartPost=$OINK_LIBEXEC/oink-obs-maximize.sh
# Restore the OBS virtual camera when it was on before the last teardown (the
# ExecStop below stops it first). Backgrounded so the retry-until-websocket-up
# wait never blocks the systemd start job; no-op when the flag file is absent.
ExecStartPost=/bin/sh -c '/usr/bin/node $STACK_DIR/start-vcam.js &'
ExecStopPost=/bin/sh -c '/usr/bin/pkill -x obs || true; sleep 1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
