---
// SPDX-FileCopyrightText: 2026 OpenIRLNodeKit contributors
// SPDX-License-Identifier: AGPL-3.0-or-later
import logoWhite from '../assets/logo-white.png';
import logoBlack from '../assets/logo-black.png';
import dashDark from '../assets/dashboard-preview-dark.png';
import dashLight from '../assets/dashboard-preview-light.png';
import '../styles/landing.css';
import { NAV } from '../data/nav';
import { FEATURES } from '../data/features';
import { STACK } from '../data/stack';
import { ICONS } from '../data/icons';
import { CSP } from '../data/csp.mjs';

const OWNER = 'OpenIRLNodeKit';
const REPO = 'OINK';
const REPO_URL = `https://github.com/${OWNER}/${REPO}`;
const INSTALL_CMD = `curl -fsSL https://openirlnodekit.com/install.sh | sudo bash`;
---

<html lang="en" data-landing>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Security-Policy" content={CSP} />
		<title>OpenIRLNodeKit - self hosted remote OBS</title>
		<meta
			name="description"
			content="OpenIRLNodeKit - Self-hosted remote OBS built for streaming."
		/>
		<meta property="og:title" content="OpenIRLNodeKit" />
		<meta
			property="og:description"
			content="Self-hosted IRL cloud-streaming box: headless OBS, remote desktop, live preview."
		/>
		<meta property="og:type" content="website" />
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem('starlight-theme');
					const theme =
						stored === 'light' || stored === 'dark'
							? stored
							: window.matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
					document.documentElement.dataset.theme = theme;
				} catch {}
			})();
		</script>
		<link rel="icon" type="image/png" href="/favicon-black.png" />
		<link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href="/favicon-white.png" />
		<link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href="/favicon-black.png" />
	</head>
	<body data-landing data-owner={OWNER} data-repo={REPO}>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href="#" aria-label="OpenIRLNodeKit home">
					<img class="brand-logo logo-dark" src={logoWhite.src} alt="OpenIRLNodeKit" />
					<img class="brand-logo logo-light" src={logoBlack.src} alt="OpenIRLNodeKit" />
				</a>
				<nav class="nav-tabs" aria-label="Sections">
					{NAV.map((n) => <a href={n.url ?? `#${n.id}`}>{n.label}</a>)}
				</nav>
				<a class="btn btn-ghost gh-btn" href={REPO_URL} target="_blank" rel="noopener noreferrer">
					<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38V13.9c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.9.87 2.36.67.07-.52.28-.87.5-1.07-1.77-.2-3.63-.88-3.63-3.91 0-.86.31-1.57.81-2.12-.08-.2-.35-1.02.08-2.12 0 0 .66-.21 2.17.81a7.5 7.5 0 0 1 3.94 0c1.5-1.02 2.17-.81 2.17-.81.43 1.1.16 1.92.08 2.12.5.55.81 1.26.81 2.12 0 3.03-1.86 3.7-3.64 3.9.28.24.54.73.54 1.48v2.19c0 .22.14.46.55.38A8 8 0 0 0 8 0Z"/>
					</svg>
					<span class="stars" data-stars>0</span>
				</a>
				<button
					class="btn btn-ghost theme-toggle"
					type="button"
					data-theme-toggle
					aria-label="Toggle color theme"
					aria-pressed="false"
				>
					<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/>
					</svg>
					<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/>
					</svg>
				</button>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="wrap">
					<h1>
						<span class="grad">OINK: </span> OpenIRLNodeKit
					</h1>
					<h2>
						Self-hosted remote OBS built for streaming.
					</h2>

					<p class="lede">
						OINK turns an Ubuntu 24.04 machine into a self-hosted streaming instance — Remote OBS, vertical, and multistreaming.
					</p>
					<div class="ctas">
						<a class="btn btn-primary" href="#getting-started">Get started</a>
						<a class="btn btn-ghost" href={REPO_URL} target="_blank" rel="noopener noreferrer">View source</a>
					</div>
				</div>

				<div class="wrap">
					<figure class="mock">
						<img class="mock-img mock-dark" src={dashDark.src} alt="OINK dashboard — dark theme" loading="lazy" decoding="async" />
						<img class="mock-img mock-light" src={dashLight.src} alt="OINK dashboard — light theme" loading="lazy" decoding="async" />
					</figure>
				</div>
			</section>

			<section id="getting-started">
				<div class="wrap">
					<div class="section-head">
						<div class="kicker">Getting Started</div>
						<h2>Up and streaming in one command.</h2>
						<p class="sub">Runs on Ubuntu 24.04 VM or Container. Install, open the dashboard.</p>
					</div>
					<div class="install-card">
						<div class="headrow">
							<span class="dots"><i></i><i></i><i></i></span>
							<span class="shell">bash</span>
							<button class="copy" type="button" data-copy={INSTALL_CMD}>Copy</button>
						</div>
						<pre><code><span class="prompt">$ </span><span class="cmd">curl</span> <span class="op">-fsSL</span> <span class="url">https://openirlnodekit.com/install.sh</span> <span class="op">|</span> <span class="cmd">sudo bash</span></code></pre>
					</div>
					<p class="note">The installer clones the repo to <code>/opt/OpenIRLNodeKit</code> and runs <code>oink.py setup</code> as root — idempotent, safe to re-run.</p>
				</div>
			</section>

			<section id="features">
				<div class="wrap">
					<div class="section-head">
						<div class="kicker">Features</div>
						<h2>Everything needed for a proper OBS cloud.</h2>
						<p class="sub">A whole live-streaming control plane in a box — browser-driven, no cloud, all yours.</p>
					</div>
					<div class="feat-grid">
						{FEATURES.map((f) => (
							<a class="feat" href={f.href} target="_blank" rel="noopener noreferrer">
								{/* set:html is safe only because ICONS values are static SVG literals in
								    ../data/icons and f.icon comes from local ../data/features. Never pass
								    untrusted data here. */}
								<span class="ico" set:html={ICONS[f.icon] ?? ''} />
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</a>
						))}
					</div>
				</div>
			</section>

			<section id="stack">
				<div class="wrap">
					<div class="section-head">
						<div class="kicker">Stack</div>
						<h2>Open source components.</h2>
						<p class="sub">This project aims to bundle all the necessary tools into one box.</p>
					</div>
					<div class="stack-grid">
						{STACK.map((s) => (
							<a class="chip" href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>
						))}
					</div>
				</div>
			</section>

			<section id="support">
				<div class="wrap">
					<div class="section-head">
						<div class="kicker">Support</div>
						<h2>OINK is free and open source.</h2>
						<p class="sub">Sponsor development to keep it that way.</p>
					</div>
					<div class="support-card">
						<div>
							<h3>$5 a month goes a long way.</h3>
							<p>Lets build something for the Open Source IRL community.</p>
						</div>
						<a
							class="btn btn-primary"
							href="https://github.com/sponsors/ImaginaryResources"
							target="_blank"
							rel="noopener noreferrer">
							<span set:html={ICONS.heart} />Sponsor
						</a>
					</div>
				</div>
			</section>

		</main>

		<footer class="site-footer">
			<div class="wrap">
				<span>© 2026 OpenIRLNodeKit · AGPL-3.0-or-later</span>
				<a href="/documentation/" title="Documentation">Documentation</a>
				<a href="/oink_branding_assets.zip" download>Branding assets</a>
				<a class="sponsor" href="https://github.com/sponsors/ImaginaryResources" target="_blank" rel="noopener noreferrer">
					<span set:html={ICONS.heart} />Sponsor
				</a>
				<span class="right"><a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a></span>
			</div>
		</footer>

		<script>
			import '../scripts/landing.js';
		</script>
	</body>
</html>
