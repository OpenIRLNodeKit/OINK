# NOALBS chat credentials (read by NOALBS from this directory's .env).
#
# `oink setup` seeds this file from OINK_TWITCH_BOT_USERNAME / OINK_TWITCH_BOT_OAUTH
# in the repo-root .env, then re-runs never clobber it — edit in place afterwards.
#
# TWITCH_BOT_USERNAME: the Twitch account NOALBS uses to read/write chat.
# TWITCH_BOT_OAUTH:    that account's token, "oauth:<token>" from twitchapps.com/tmi.
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=oauth:
